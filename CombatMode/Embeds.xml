<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
    <!-- RUNTIME: Runtime.lua defines the AddOn namespace (CM via ...) before Constants
         and feature modules load. -->
    <Script file="Core\Runtime\Runtime.lua"/>
    <!-- CONSTANTS (must load before feature consumers) -->
    <Script file="Constants\Namespace.lua"/>
    <Script file="Constants\CVars.lua"/>
    <Script file="Constants\Assets.lua"/>
    <Script file="Constants\Gameplay.lua"/>
    <Script file="Constants\DatabaseDefaults.lua"/>
    <Script file="Constants\HealingRadial.lua"/>
    <Script file="Constants\FrameWatch.lua"/>
    <Script file="Constants\Reticle.lua"/>
    <!-- RUNTIME support (events, CVars, deferred bindings, bootstrap) -->
    <Script file="Core\Runtime\EventRouter.lua"/>
    <Script file="Core\Runtime\CVarManager.lua"/>
    <Script file="Core\Runtime\BindingQueue.lua"/>
    <Script file="Core\Runtime\Bootstrap.lua"/>
    <!-- CLICK CASTING -->
    <Script file="Core\ClickCasting\AddonActionBarResolver.lua"/>
    <Script file="Core\ClickCasting\TargetingMacroBuilder.lua"/>
    <Script file="Core\ClickCasting\BindingOverrides.lua"/>
    <!-- FREE LOOK -->
    <Script file="Core\FreeLook\FreeLookController.lua"/>
    <Script file="Core\FreeLook\AutoCursorUnlock.lua"/>
    <!-- CROSSHAIR (+ companions) -->
    <Script file="Core\Crosshair\Animations.lua"/>
    <Script file="Core\Crosshair\InteractionHUD.lua"/>
    <Script file="Core\Crosshair\AssistedHighlight.lua"/>
    <Script file="Core\Crosshair\Crosshair.lua"/>
    <!-- HEALING RADIAL -->
    <Script file="Core\HealingRadial\HealingRadial.lua"/>
    <!-- OPTIONS UI: custom standalone window. Draw + Widgets before
         OptionsPanel (defines AddTab/CreateWindow); Tabs register after OptionsPanel. -->
    <Script file="UI\Options\Draw.lua"/>
    <Script file="UI\Options\Widgets.lua"/>
    <Script file="UI\Options\OptionsPanel.lua"/>
    <Script file="UI\Options\Tabs\TabGeneral.lua"/>
    <Script file="UI\Options\Tabs\TabCrosshair.lua"/>
    <Script file="UI\Options\Tabs\TabReticleTargeting.lua"/>
    <Script file="UI\Options\Tabs\TabClickCasting.lua"/>
    <Script file="UI\Options\Tabs\TabAutoCursorUnlock.lua"/>
    <Script file="UI\Options\Tabs\TabCamera.lua"/>
    <Script file="UI\Options\Tabs\TabHealingRadial.lua"/>
    <!-- CHANGELOG: in-game viewer. ChangelogNamespace first (defines CM.Config);
         panel uses the OPTIONS UI toolkit loaded above. -->
    <Script file="UI\Changelog\ChangelogNamespace.lua"/>
    <Script file="UI\Changelog\ChangelogData.lua"/>
    <Script file="UI\Changelog\ChangelogPanel.lua"/>
    <!-- EDITORS: standalone secondary windows built on the OPTIONS UI toolkit. -->
    <Script file="UI\Editors\ReticleCVarEditorData.lua"/>
    <Script file="UI\Editors\ReticleCVarEditorPanel.lua"/>
    <Script file="UI\Editors\TargetingMacroPrelinesEditor.lua"/>
    <!-- FRAME -->
    <Frame name="CombatModeFrame" hidden="false" parent="UIParent" inherits="SecureHandlerStateTemplate">
        <Scripts>
            <OnUpdate function="CombatMode_OnUpdate"/>
            <OnEvent function="CombatMode_OnEvent"/>
        </Scripts>
    </Frame>
</Ui>
